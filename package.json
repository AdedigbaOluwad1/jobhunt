{
  "name": "jobhunt",
  "version": "0.1.0",
  "description": "CLI that syncs job postings from ATS boards and remote-job aggregators, scores them against your profile with an LLM, and generates fact-checked, tailored CVs.",
  "keywords": ["cli", "job-search", "ats", "llm", "cv", "resume"],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdedigbaOluwad1/jobhunt"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jobhunt": "dist/main.js"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "postbuild": "node scripts/make-bin-executable.js",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:live": "jest --config jest.live.config.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.4",
    "fast-xml-parser": "^5.11.1",
    "html-to-text": "^10.0.1",
    "nest-commander": "^3.21.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "pdf-parse": "^2.4.5",
    "prisma": "7.10.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
